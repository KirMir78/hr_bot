# Токен бота, который выдал BotFather. Нужен и боту, и для проверки Login Widget
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Имя бота без @, используется на фронте в виджете логина
TELEGRAM_BOT_USERNAME=your_hr_bot

# Ключ DeepSeek API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-example

# Секрет для подписи собственных JWT-сессий сайта (сгенерируйте случайную строку)
JWT_SECRET=change-me-to-a-long-random-string

# dev — включает /auth/dev-login для локальной разработки без настройки домена в BotFather
# prod — dev-login выключен
APP_ENV=dev

# Домен, с которого фронт обращается к API. На проде — https://yourdomain.com
ALLOWED_ORIGIN=http://localhost:8080
